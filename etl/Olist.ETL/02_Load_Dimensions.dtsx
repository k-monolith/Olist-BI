  <DTS:Variables />
  <DTS:Executables>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimCustomer"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{A0D7F9F8-755E-458D-A43A-D1B8C2FB4468}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load DimCustomer"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{939098EC-4C61-434D-8605-36DF0B130DC2}"
          SQLTask:SqlStatementSource="WITH latest AS (&#xA;    SELECT c.customer_unique_id,&#xA;           c.customer_zip_code_prefix,&#xA;           c.customer_city,&#xA;           c.customer_state,&#xA;           ROW_NUMBER() OVER (&#xA;               PARTITION BY c.customer_unique_id&#xA;               ORDER BY o.order_purchase_timestamp DESC, c.customer_id DESC&#xA;           ) AS rn&#xA;    FROM OlistStaging.stg.customers AS c&#xA;    JOIN OlistStaging.stg.orders    AS o&#xA;      ON o.customer_id = c.customer_id&#xA;)&#xA;INSERT INTO dw.DimCustomer (CustomerUniqueId, ZipCodePrefix, City, [State])&#xA;SELECT l.customer_unique_id, l.customer_zip_code_prefix, l.customer_city, l.customer_state&#xA;FROM latest AS l&#xA;WHERE l.rn = 1&#xA;  AND NOT EXISTS (SELECT 1 FROM dw.DimCustomer AS d&#xA;                  WHERE d.CustomerUniqueId = l.customer_unique_id);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimGeography"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{E47110F2-F757-4957-A3EA-BC39B60C56A5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load DimGeography"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{939098EC-4C61-434D-8605-36DF0B130DC2}"
          SQLTask:SqlStatementSource="INSERT INTO dw.DimGeography (ZipCodePrefix, City, [State], Latitude, Longitude)&#xA;SELECT g.geolocation_zip_code_prefix,&#xA;       ISNULL(g.geolocation_city,  N'Unknown'),&#xA;       ISNULL(g.geolocation_state, N'??'),&#xA;       g.geolocation_lat,&#xA;       g.geolocation_lng&#xA;FROM OlistStaging.stg.geolocation AS g&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.DimGeography AS d&#xA;                  WHERE d.ZipCodePrefix = g.geolocation_zip_code_prefix);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimOrderStatus"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{11AAEC9A-406F-4B8A-86CD-DA9380B54BAE}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load DimOrderStatus"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{939098EC-4C61-434D-8605-36DF0B130DC2}"
          SQLTask:SqlStatementSource="INSERT INTO dw.DimOrderStatus (OrderStatusName)&#xA;SELECT DISTINCT o.order_status&#xA;FROM OlistStaging.stg.orders AS o&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.DimOrderStatus AS d&#xA;                  WHERE d.OrderStatusName = o.order_status);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimPaymentType"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{7CE09D77-B5A9-4DC1-88DC-8EC7CE40DA52}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load DimPaymentType"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{939098EC-4C61-434D-8605-36DF0B130DC2}"
          SQLTask:SqlStatementSource="INSERT INTO dw.DimPaymentType (PaymentTypeName)&#xA;SELECT DISTINCT p.payment_type&#xA;FROM OlistStaging.stg.payments AS p&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.DimPaymentType AS d&#xA;                  WHERE d.PaymentTypeName = p.payment_type);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimProduct"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{1A6820E6-4BA6-4E19-9C92-745892F106F6}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load DimProduct"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{939098EC-4C61-434D-8605-36DF0B130DC2}"
          SQLTask:SqlStatementSource="INSERT INTO dw.DimProduct (ProductId, CategoryPt, CategoryEn, NameLength,&#xA;                           DescriptionLength, PhotosQty, WeightG,&#xA;                           LengthCm, HeightCm, WidthCm)&#xA;SELECT p.product_id,&#xA;       p.product_category_name,&#xA;       p.product_category_name_english,&#xA;       CAST(p.product_name_length        AS SMALLINT),&#xA;       CAST(p.product_description_length AS SMALLINT),&#xA;       CAST(p.product_photos_qty         AS TINYINT),&#xA;       CAST(p.product_weight_g           AS INT),&#xA;       CAST(p.product_length_cm          AS SMALLINT),&#xA;       CAST(p.product_height_cm          AS SMALLINT),&#xA;       CAST(p.product_width_cm           AS SMALLINT)&#xA;FROM OlistStaging.stg.products AS p&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.DimProduct AS d&#xA;                  WHERE d.ProductId = p.product_id);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL Load DimSeller"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{F5578D3E-8110-49E9-8A8B-81F4F45F8786}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL Load DimSeller"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{939098EC-4C61-434D-8605-36DF0B130DC2}"
          SQLTask:SqlStatementSource="INSERT INTO dw.DimSeller (SellerId, ZipCodePrefix, City, [State])&#xA;SELECT s.seller_id, s.seller_zip_code_prefix, s.seller_city, s.seller_state&#xA;FROM OlistStaging.stg.sellers AS s&#xA;WHERE NOT EXISTS (SELECT 1 FROM dw.DimSeller AS d&#xA;                  WHERE d.SellerId = s.seller_id);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
