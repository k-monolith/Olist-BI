        "measures": [
          {
            "name": "Payment Value",
            "expression": " SUM ( 'dw FactPayment'[PaymentValue] )"
          },
          {
            "name": "Average Review Score",
            "expression": " AVERAGE ( 'dw FactReview'[ReviewScore] )"
          },
          {
            "name": "Comment Share",
            "expression": " DIVIDE ( CALCULATE ( COUNTROWS ( 'dw FactReview' ), 'dw FactReview'[HasComment] = TRUE ), COUNTROWS ( 'dw FactReview' ) )"
          }
