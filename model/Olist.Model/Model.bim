        "partitions": [
          {
            "name": "Partition",
            "dataView": "full",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #\"SQL/localhost\\MSSQLSERVER01;OlistDW\",",
                "    dw_FactOrderItem = Source{[Schema=\"dw\",Item=\"FactOrderItem\"]}[Data]",
                "in",
                "    dw_FactOrderItem"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Revenue",
            "expression": " SUM ( 'dw FactOrderItem'[Price] )"
          },
          {
            "name": "Freight",
            "expression": " SUM ( 'dw FactOrderItem'[FreightValue] )"
          },
          {
            "name": "GMV",
            "expression": " [Revenue] + [Freight]"
          },
          {
            "name": "GMV Delivered",
            "expression": " CALCULATE ( [GMV], 'dw DimOrderStatus'[OrderStatusName] = \"delivered\" )"
          },
          {
            "name": "Orders",
            "expression": " DISTINCTCOUNT ( 'dw FactOrderItem'[OrderId] )"
          },
          {
            "name": "Delivered Orders",
            "expression": " CALCULATE ( [Orders], 'dw DimOrderStatus'[OrderStatusName] = \"delivered\" )"
          },
          {
            "name": "Late Rate",
            "expression": " DIVIDE ( CALCULATE ( [Orders], FILTER ( 'dw FactOrderItem', 'dw FactOrderItem'[IsLate] = TRUE () ) ), CALCULATE ( [Orders], FILTER ( 'dw FactOrderItem', NOT ISBLANK ( 'dw FactOrderItem'[IsLate] ) ) ) )"
          },
          {
            "name": "Average Order Value",
            "expression": " DIVIDE ( [GMV Delivered], [Delivered Orders] )"
          },
          {
            "name": "Average Delivery Days",
            "expression": " AVERAGE ( 'dw FactOrderItem'[DeliveryDays] )"
          }
        ]
      },
